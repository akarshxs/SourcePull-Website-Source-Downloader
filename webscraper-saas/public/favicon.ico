<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
  <!-- Dark automotive canvas base with Rosso Corsa frame -->
  <rect width="64" height="64" fill="#181818" rx="10" />
  <rect x="2" y="2" width="60" height="60" fill="none" stroke="#da291c" stroke-width="2.5" rx="8" />
  
  <!-- Subtle radar sweep background lines -->
  <circle cx="32" cy="32" r="22" stroke="#303030" stroke-width="1.5" stroke-dasharray="3 3" />
  <circle cx="32" cy="32" r="13" stroke="#303030" stroke-width="1.5" />
  <line x1="32" y1="10" x2="32" y2="54" stroke="#da291c" stroke-width="1" opacity="0.35" />
  <line x1="10" y1="32" x2="54" y2="32" stroke="#da291c" stroke-width="1" opacity="0.35" />
  
  <!-- Top & Bottom Mandibles / Sensor Probes -->
  <path d="M26 21 L32 15 L38 21" stroke="#ffffff" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" />
  <path d="M28 43 L32 47 L36 43" stroke="#da291c" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" />
  
  <!-- Crawler Legs Left -->
  <path d="M24 25 L14 18 L8 22" stroke="#da291c" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" />
  <path d="M23 32 L11 32 L5 36" stroke="#ffffff" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" />
  <path d="M24 39 L14 46 L8 42" stroke="#da291c" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" />
  
  <!-- Crawler Legs Right -->
  <path d="M40 25 L50 18 L56 22" stroke="#da291c" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" />
  <path d="M41 32 L53 32 L59 36" stroke="#ffffff" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" />
  <path d="M40 39 L50 46 L56 42" stroke="#da291c" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" />
  
  <!-- Core Chassis: Sharp Angular Diamond / Hexagon -->
  <polygon points="32,21 41,27 41,37 32,43 23,37 23,27" fill="#da291c" stroke="#ffffff" stroke-width="2" />
  
  <!-- Glowing Sensor Eye -->
  <circle cx="32" cy="32" r="4.5" fill="#ffffff" />
  <circle cx="32" cy="32" r="2" fill="#181818" />
</svg>
